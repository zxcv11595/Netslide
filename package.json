{
  "name": "hamster-snack-delivery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "generate": "node --max-old-space-size=8192 tools/generate.js",
    "verify": "node --max-old-space-size=8192 tools/verify.js",
    "deploy": "node tools/deploy.js",
