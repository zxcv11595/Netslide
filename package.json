    "app:open": "cap open android",
    "app:build": "node tools/app-build.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10"
  }
}
